
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

// --- People -----------------------------------------------------------

// role: "CLIENT" | "TECHNICIAN" | "ADMIN" | "SOUS_ADMIN"
model User {
  id              String   @id @default(cuid())
  fullName        String
  phone           String   @unique
  email           String?  @unique
  passwordHash    String
  role            String
  city            String?
  address         String?
  avatarUrl       String?
  faceDescriptor  String?
  sessionVersion  Int      @default(0)
  createdAt       DateTime @default(now())

  technician              Technician?
  requestsMade            ServiceRequest[]   @relation("ClientRequests")
  messagesSent            Message[]
  reviewsWritten          Review[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  knownDevices            KnownDevice[]
  sentSupportMessages     SupportMessage[]   @relation("SentSupport")
  receivedSupportMessages SupportMessage[]   @relation("ReceivedSupport")
}

model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model SupportMessage {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SentSupport", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReceivedSupport", fields: [toUserId], references: [id], onDelete: Cascade)
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// --- Technician -------------------------------------------------------

// accountStatus: "PENDING" | "ACTIVE" | "DECLINED" | "ARCHIVED"
model Technician {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  bio             String?
  yearsExperience Int       @default(0)
  startingPrice   Int       @default(0)
  latitude        Float     @default(36.8065)
  longitude       Float     @default(10.1815)
  verified        Boolean   @default(false)
  galleryImages   String?

  // Identity documents (Cloudinary URLs)
  cinUrl          String?
  diplomeUrl      String?

  // Senior Pro
  isSenior        Boolean   @default(false)
  seniorSince     DateTime?

  // Account approval flow
  accountStatus   String    @default("PENDING")

  // Transport / departure tracking
  departureLatitude  Float?
  departureLongitude Float?
  departureAt        DateTime?
  distanceTraveled   Float?   // km, calculated on arrival
  transportFee       Int?     // DT × 100 (millimes) or just DT integer

  planId          String?
  plan            Plan?     @relation(fields: [planId], references: [id])
  createdAt       DateTime  @default(now())

  categories       Category[]
  requestsReceived ServiceRequest[]   @relation("TechnicianRequests")
  reviews          Review[]           @relation("TechnicianReviews")
  payments         Payment[]
  subscriptions    Subscription[]
  portfolioItems   PortfolioItem[]
}

model PortfolioItem {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type         String     // "IMAGE" | "VIDEO"
  url          String
  publicId     String
  caption      String?
  createdAt    DateTime   @default(now())
}

// --- Catalog ----------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  icon        String
  color       String
  description String?
  howItWorks  String?
  videoUrl    String?
  ratingAvg   Float?
  ratingCount Int?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)   // false → grayed out on home, not bookable
  visitPrice  Int     @default(0)       // DT — prix de visite set by admin

  technicians Technician[]
  requests    ServiceRequest[]
}

// --- Booking lifecycle ------------------------------------------------

model ServiceRequest {
  id           String     @id @default(cuid())
  clientId     String
  client       User       @relation("ClientRequests", fields: [clientId], references: [id])
  technicianId String
  technician   Technician @relation("TechnicianRequests", fields: [technicianId], references: [id])
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])

  fullName    String
  phone       String
  address     String
  latitude    Float?
  longitude   Float?
  description String
  photos      String?

  status                String   @default("PENDING")
  clientConfirmedSolved Boolean?

  // Timestamps for each status step
  pendingAt    DateTime  @default(now())
  acceptedAt   DateTime?
  onTheWayAt   DateTime?
  arrivedAt    DateTime?
  inProgressAt DateTime?
  completedAt  DateTime?
  declinedAt   DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  review   Review?
  payment  Payment?
}

model Message {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User           @relation(fields: [senderId], references: [id])
  body      String?
  imageUrl  String?
  createdAt DateTime       @default(now())
}

model Review {
  id           String         @id @default(cuid())
  requestId    String         @unique
  request      ServiceRequest @relation(fields: [requestId], references: [id])
  technicianId String
  technician   Technician     @relation("TechnicianReviews", fields: [technicianId], references: [id])
  authorId     String
  author       User           @relation(fields: [authorId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime       @default(now())
}

// --- Monetization -----------------------------------------------------

// key: "FREE" | "BEGINNER" | "PRO"
// FREE    → limited requests, 20% commission, 10km radius
// BEGINNER → 20 requests/mo, 15% commission, 30km radius (default on register)
// PRO     → unlimited, 8% commission, 150km radius
model Plan {
  id                  String  @id @default(cuid())
  key                 String  @unique
  name                String
  price               Int     // monthly price in DT (0 for FREE and BEGINNER)
  billingCycle        String  // "NONE" | "MONTHLY" | "YEARLY"
  commissionRate      Float
  maxRequestsPerMonth Int?
  priorityVisibility  Boolean @default(false)
  radiusKm            Int     @default(30) // visibility radius in km
  features            String  // JSON-encoded string[]
  badge               String?

  technicians   Technician[]
  subscriptions Subscription[]
}

model Subscription {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  planId       String
  plan         Plan       @relation(fields: [planId], references: [id])
  startedAt    DateTime   @default(now())
  expiresAt    DateTime?
  status       String     @default("ACTIVE")
}

model Payment {
  id           String          @id @default(cuid())
  technicianId String
  technician   Technician      @relation(fields: [technicianId], references: [id])
  requestId    String?         @unique
  request      ServiceRequest? @relation(fields: [requestId], references: [id])
  amount       Int
  platformFee  Int             @default(0)
  method       String
  status       String          @default("PAID")
  type         String
  createdAt    DateTime        @default(now())
}

// --- Plan promotion config -------------------------------------------

model PlanConfig {
  id               String   @id @default(cuid())
  minTotalReviews  Int      @default(15)
  minFiveStarCount Int      @default(10)
  minAverageRating Float    @default(4.5)
  minFourStarCount Int      @default(8)
  updatedAt        DateTime @updatedAt
}

// --- Notifications ---------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  requestId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}